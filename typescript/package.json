{
  "name": "@factorialco/api-client",
  "version": "1.0.2",
  "description": "Official TypeScript SDK for the Factorial API",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "generate": "openapi-ts",
    "generate-sdk": "tsx scripts/generate-sdk.ts",
    "release": "tsx scripts/release.ts",
    "release:dry-run": "tsx scripts/release.ts --dry-run",
    "test:api": "tsx scripts/test-api.ts"
  },
  "keywords": [
    "factorial",
    "hr",
    "api",
    "sdk",
    "typescript",
    "openapi"
  ],
  "license": "MIT",
  "devDependencies": {
    "@hey-api/openapi-ts": "0.98.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
